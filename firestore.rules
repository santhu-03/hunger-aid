rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// HungerAid Firestore Security Rules
// ═══════════════════════════════════════════════════════════════════════════════
//
// SECURITY ARCHITECTURE
// ─────────────────────
// 1. All operations require authentication (isSignedIn guard on every match).
//
// 2. CROSS-USER DATA ISOLATION
//    • notifications: strict per-user isolation — read/update/delete only when
//      resource.data.userId == request.auth.uid
//    • OTP: stored in foodRequests.otp — only beneficiary and admin can read
//      the full foodRequests document (volunteer read removed to enforce OTP
//      isolation; volunteer validates via the app layer, not direct Firestore reads)
//
// 3. OTP PROTECTION
//    • foodRequests is readable by beneficiary, donor, and admin ONLY.
//    • Volunteer is REMOVED from foodRequests read access.
//    • OTP validation in the app layer calls validateOTP() which reads the doc
//      as the calling user. If you need hard server-side isolation, replace
//      validateOTP() with a Cloud Function.
//    • Firestore rule on notifications/OTP_DELIVERY type prevents volunteers from
//      querying OTP notifications (they can't read others' notifications anyway).
//
// 4. ROLE PROTECTION
//    • Users cannot change their own role or status — only admins may do so.
//    • Privilege escalation is blocked at the rule level.
//
// 5. BRUTE FORCE MITIGATION
//    • otpAttempts increments are performed by the app before each comparison.
//    • If otpAttempts >= 5 the app (and future Cloud Function) rejects the attempt.
//    • Firestore rules alone cannot enforce rate-limiting — use Cloud Functions
//      for production-grade OTP security.
//
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Reads the role field from the caller's user document.
    // Cached across rules in the same request.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole().matches('(?i)^admin$');
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    //
    // • Any authenticated user may read any user document (volunteer matching,
    //   admin UI, profile pages all require cross-user reads).
    // • Users may only write their own document.
    // • role and status are immutable by the owner — admin only.
    // • Volunteer assignment fields (availability, assignedDonationId, etc.)
    //   may be cross-written by the client assignment flow; ideally these writes
    //   would be in a Cloud Function.

    match /users/{userId} {
      allow create: if isSignedIn() && uid() == userId;
      allow read:   if isSignedIn();

      allow update: if isSignedIn() && (
        // Owner can update their own profile except role/status
        (uid() == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
        ||
        isAdmin()
        ||
        // Client-side volunteer assignment writes (availability, location, etc.)
        // scoped to volunteer documents only.
        // Use affectedKeys() (keys that are *changing*) not keys() (entire resulting document).
        (resource.data.role.matches('(?i)^volunteer$') &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'availability',
           'assignedDonationId',
           'currentDeliveryStatus',
           'updatedAt',
           'location',
           'transportAvailability',
           'transportActive',
           'expoPushToken',
           'pushTokenUpdatedAt',
         ]))
      );

      allow delete: if isSignedIn() && (uid() == userId || isAdmin());
    }

    // ── Donations ─────────────────────────────────────────────────────────────
    //
    // Donors create; participants (donor, beneficiary, assigned volunteer) read
    // and update.  Only the donor may delete.

    match /donations/{donationId} {
      allow create: if isSignedIn() && request.resource.data.donorId == uid();

      allow read: if isSignedIn() && (
        resource.data.donorId              == uid() ||
        resource.data.offeredTo            == uid() ||
        resource.data.beneficiaryId        == uid() ||
        resource.data.assignedVolunteerId  == uid() ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        resource.data.donorId              == uid() ||
        resource.data.offeredTo            == uid() ||
        resource.data.beneficiaryId        == uid() ||
        // Use resource.data (not request.resource.data) for volunteer check
        // to prevent any user self-assigning as volunteer.
        resource.data.assignedVolunteerId  == uid() ||
        isAdmin()
      );

      allow delete: if isSignedIn() && resource.data.donorId == uid();
    }

    // ── Food Requests ─────────────────────────────────────────────────────────
    //
    // OTP ISOLATION:
    //   Volunteer is intentionally excluded from read access.  The OTP field
    //   lives in this document.  The client-side validateOTP() function reads
    //   this document and validates the OTP on behalf of the volunteer's
    //   session — this is a practical compromise.  To fully prevent volunteers
    //   from ever seeing the OTP, replace validateOTP() with a Cloud Function.
    //
    //   Beneficiary, donor, and admin may read (beneficiary needs to see OTP
    //   status; donor needs delivery confirmation).
    //
    // OTP WRITE GUARDS:
    //   Only participants may update.  The client enforces attempt counting and
    //   expiry checks before each update.

    match /foodRequests/{requestId} {
      allow create: if isSignedIn();

      // OTP isolation: beneficiary, donor, assigned volunteer, and admin may read.
      //
      // CRITICAL: resource == null must be the first check.
      // When the document does not yet exist, Firestore evaluates resource as null.
      // Accessing resource.data.X on a null resource throws a rule evaluation error
      // and defaults to DENIED — which blocked initOTPIfNeeded and subscribeToFoodRequest
      // before the document was ever created.  Allowing reads of non-existent documents
      // is safe: there is no data to expose when the document does not exist.
      //
      // Once the document is created (by createAndStoreOTP / setDoc merge), the
      // volunteerId field is written into it, so subsequent reads are controlled by
      // the participant-ID checks below.
      allow read: if isSignedIn() && (
        resource == null               ||   // document does not exist yet — safe, nothing to expose
        resource.data.beneficiaryId == uid() ||
        resource.data.donorId       == uid() ||
        resource.data.volunteerId   == uid() ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        resource.data.beneficiaryId == uid() ||
        resource.data.donorId       == uid() ||
        resource.data.volunteerId   == uid() ||
        isAdmin()
      );

      // OTP documents are never deleted — they are cleared (otp: null) on completion.
      allow delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    //
    // STRICT PER-USER ISOLATION — no cross-user access under any circumstances.
    //
    //  READ:   only when resource.data.userId == caller uid
    //  CREATE: any authenticated user may create a notification for any userId
    //          (this allows donors/volunteers/system to notify beneficiaries, etc.)
    //          Required fields: type (string) and userId (string)
    //  UPDATE: only the owner; only the `read` field may be changed
    //          (prevents clients from altering title, message, OTP, userId, etc.)
    //  DELETE: only the owner
    //
    // OTP notifications (type == 'otp_delivery') are created only for the
    // beneficiary by sendOTPNotification().  Volunteers never receive them.

    match /notifications/{docId} {
      allow read: if isSignedIn()
        && resource.data.userId == uid();

      allow create: if isSignedIn()
        && request.resource.data.type   is string
        && request.resource.data.userId is string;

      allow update: if isSignedIn()
        && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isSignedIn()
        && resource.data.userId == uid();
    }

    // ── Delivery Tracking ──────────────────────────────────────────────────────
    //
    // Tracks real-time delivery status timeline.
    // Participants: donor, beneficiary, volunteer, currentAssignedVolunteer.
    // Admin has full access for analytics and recovery sweeps.

    match /deliveryTracking/{donationId} {
      allow create: if isSignedIn() && (
        request.resource.data.donorId                  == uid() ||
        request.resource.data.beneficiaryId            == uid() ||
        request.resource.data.volunteerId              == uid() ||
        request.resource.data.currentAssignedVolunteer == uid() ||
        isAdmin()
      );

      allow read: if isSignedIn() && (
        resource.data.donorId                  == uid() ||
        resource.data.beneficiaryId            == uid() ||
        resource.data.volunteerId              == uid() ||
        resource.data.currentAssignedVolunteer == uid() ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        resource.data.donorId                  == uid() ||
        resource.data.beneficiaryId            == uid() ||
        resource.data.volunteerId              == uid() ||
        resource.data.currentAssignedVolunteer == uid() ||
        isAdmin()
      );

      allow delete: if false;
    }

    // ── Transport Requests ────────────────────────────────────────────────────

    match /transportRequests/{requestId} {
      allow create: if isSignedIn();

      allow read: if isSignedIn() && (
        resource.data.donorId       == uid() ||
        resource.data.beneficiaryId == uid() ||
        resource.data.volunteerId   == uid() ||
        get(/databases/$(database)/documents/donations/$(resource.data.donationId))
          .data.assignedVolunteerId == uid() ||
        isAdmin()
      );

      allow update: if isSignedIn() && resource.data.volunteerId == uid();

      allow delete: if isSignedIn() && (
        resource.data.volunteerId   == uid() ||
        resource.data.beneficiaryId == uid() ||
        get(/databases/$(database)/documents/donations/$(resource.data.donationId))
          .data.assignedVolunteerId == uid() ||
        isAdmin()
      );
    }

    // ── Delivery Tasks ────────────────────────────────────────────────────────

    match /deliveryTasks/{taskId} {
      allow read: if isSignedIn() && (
        resource.data.currentVolunteerId == uid() ||
        resource.data.volunteerId        == uid() ||
        resource.data.donorId            == uid() ||
        resource.data.beneficiaryId      == uid() ||
        isAdmin()
      );

      allow update: if isSignedIn()
        && resource.data.currentVolunteerId == uid()
        && resource.data.status             == 'Offered'
        && request.resource.data.status     in ['Accepted', 'Rejected', 'Offered', 'Unassigned'];

      allow create, delete: if false;
    }

    // ── Donation History Events ───────────────────────────────────────────────

    match /donationHistoryEvents/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.participantIds.hasAny([uid()]) ||
        resource.data.donorId == uid()               ||
        isAdmin()
      );

      allow create: if isSignedIn() && (
        request.resource.data.participantIds.hasAny([uid()]) ||
        request.resource.data.donorId == uid()                ||
        isAdmin()
      );

      allow update, delete: if false;
    }

    // ── Activity Feed Posts ───────────────────────────────────────────────────

    match /posts/{postId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ── Aggregate Stats ───────────────────────────────────────────────────────

    match /stats/{statId} {
      allow read:  if isSignedIn();
      allow write: if false;   // server / Cloud Functions only
    }

    // ── Chats ─────────────────────────────────────────────────────────────────
    //
    // Chat rooms are keyed by donationId.  Only participants of the donation
    // may read or write the room and its messages.
    // Participants are tracked in the participantIds array field.

    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.participantIds.hasAny([uid()])
      );

      allow create: if isSignedIn()
        && request.resource.data.participantIds.hasAny([uid()]);

      allow update: if isSignedIn()
        && resource.data.participantIds.hasAny([uid()]);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId))
               .data.participantIds.hasAny([uid()]);

        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId))
               .data.participantIds.hasAny([uid()])
          && request.resource.data.senderId == uid()
          && request.resource.data.text     is string;

        allow update, delete: if false;
      }
    }

    // ── Rewards ───────────────────────────────────────────────────────────────
    //
    // Each volunteer has one document keyed by their UID.
    // Volunteers may read their own; admins may read all.
    // Writes are restricted to server-side / the owning volunteer so that
    // clients cannot arbitrarily inflate their own scores.
    // The client awards points via awardDeliveryPoints() which runs as the
    // signed-in volunteer, so direct writes are allowed here with the owner
    // guard; in production you would move this to a Cloud Function.

    match /rewards/{volunteerId} {
      allow read: if isSignedIn() && (uid() == volunteerId || isAdmin());

      allow create: if isSignedIn() && uid() == volunteerId;

      allow update: if isSignedIn() && (uid() == volunteerId || isAdmin());

      allow delete: if false;
    }

    // ── Live Tracking ─────────────────────────────────────────────────────────
    //
    // One document per active delivery keyed by donationId.
    // Volunteer writes; donation participants read; admin full access.

    match /liveTracking/{donationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.volunteerId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.donorId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.beneficiaryId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.offeredTo == uid() ||
        isAdmin()
      );

      allow create: if isSignedIn() && request.resource.data.volunteerId == uid();

      allow update: if isSignedIn() && (
        resource.data.volunteerId == uid() ||
        isAdmin()
      );

      allow delete: if isSignedIn() && (
        resource.data.volunteerId == uid() ||
        isAdmin()
      );
    }

    // ── Routes ────────────────────────────────────────────────────────────────
    //
    // Computed driving routes keyed by donationId.

    match /routes/{donationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.donorId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.beneficiaryId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.assignedVolunteerId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.offeredTo == uid() ||
        isAdmin()
      );

      allow create: if isSignedIn() && (
        get(/databases/$(database)/documents/donations/$(donationId)).data.assignedVolunteerId == uid() ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        get(/databases/$(database)/documents/donations/$(donationId)).data.assignedVolunteerId == uid() ||
        isAdmin()
      );

      allow delete: if false;
    }

    // ── Tracking History ──────────────────────────────────────────────────────
    //
    // Completed route breadcrumbs keyed by donationId.

    match /trackingHistory/{donationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.donorId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.beneficiaryId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.assignedVolunteerId == uid() ||
        isAdmin()
      );

      allow create: if isSignedIn() && request.resource.data.volunteerId == uid();

      allow update: if isSignedIn() && (
        resource.data.volunteerId == uid() ||
        isAdmin()
      );

      allow delete: if false;
    }

    // ── Geofences ─────────────────────────────────────────────────────────────
    //
    // One document per active delivery keyed by donationId.
    // Volunteer (owner) writes; donation participants read; admin full access.

    match /geofences/{donationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.volunteerId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.donorId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.beneficiaryId == uid() ||
        isAdmin()
      );

      allow create: if isSignedIn() && request.resource.data.volunteerId == uid();

      allow update: if isSignedIn() && (
        resource.data.volunteerId == uid() ||
        isAdmin()
      );

      allow delete: if false;
    }

    // ── Geofence Events ───────────────────────────────────────────────────────
    //
    // Append-only event log. Volunteer writes; participants + admin read.

    match /geofenceEvents/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.volunteerId == uid()
        && request.resource.data.donationId  is string;

      allow read: if isSignedIn() && (
        resource.data.volunteerId == uid() ||
        get(/databases/$(database)/documents/donations/$(resource.data.donationId)).data.donorId == uid() ||
        get(/databases/$(database)/documents/donations/$(resource.data.donationId)).data.beneficiaryId == uid() ||
        isAdmin()
      );

      allow update, delete: if false;
    }

    // ── Tracking Logs ─────────────────────────────────────────────────────────
    //
    // Sub-collection  trackingLogs/{donationId}/positions/{posId}.
    // Volunteer writes positions; participants + admin read.

    match /trackingLogs/{donationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.donorId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.beneficiaryId == uid() ||
        get(/databases/$(database)/documents/donations/$(donationId)).data.assignedVolunteerId == uid() ||
        isAdmin()
      );
      allow write: if false; // only sub-collection writes allowed

      match /positions/{posId} {
        allow create: if isSignedIn()
          && request.resource.data.volunteerId == uid()
          && request.resource.data.donationId  is string;

        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/donations/$(donationId)).data.donorId == uid() ||
          get(/databases/$(database)/documents/donations/$(donationId)).data.beneficiaryId == uid() ||
          get(/databases/$(database)/documents/donations/$(donationId)).data.assignedVolunteerId == uid() ||
          isAdmin()
        );

        allow update, delete: if false;
      }
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    // Explicitly deny all other collections.  Removing this line would make
    // Firestore fall through to "no rules = deny" anyway, but being explicit
    // prevents accidental exposure if a collection is added without rules.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
